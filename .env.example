# Placeholder values only. Copy to .env.local and set real values. NEVER commit real secrets.

# Secret for POST /api/tests/revalidate. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_TOKEN=replace-me-with-at-least-32-random-characters

# The long-running and body-size endpoints can be abused on a public host.
# They return 404 unless this is exactly "true". Default: false.
ENABLE_STRESS_TESTS=false

# Used by the environment-variable test. The VALUE is never displayed, only
# present/absent and a hash. Any non-empty string works.
SERVER_ONLY_PROBE=replace-me-server-only-probe

# Inlined into the client bundle at BUILD time (test 19). Not a secret.
NEXT_PUBLIC_BUILD_LABEL=local

# Origin of THIS deployment, used by the fetch-cache test to call its own route handler.
# Leave unset locally (falls back to http://127.0.0.1:PORT). Set to your deployed URL on hosts.
# SELF_ORIGIN=https://your-deployment.example
