{
  "name": "nextjs-hosting-compat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Test suite that probes how well hosting providers support Next.js features",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "variants/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck -w compat-cache-components",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:compat": "node scripts/run-compat-tests.ts",
    "test:local": "node scripts/test-local.ts",
    "build:standalone": "BUILD_OUTPUT=standalone next build",
    "build:export": "node scripts/build-export.mjs",
    "serve:export": "node scripts/serve-export.mjs",
    "test:export": "node scripts/test-export.mjs",
    "build:cache-components": "npm run build -w compat-cache-components",
    "test:local:cache-components": "node scripts/test-local.ts --variant cache-components",
    "test:docker": "node scripts/test-docker.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
